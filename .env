# ── MarkGigs Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is gitignored — never commit secrets.

SECRET_KEY=change-this-to-a-long-random-string

# MySQL (XAMPP defaults)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=markgig_db
MYSQL_PORT=3306

# SMTP — Gmail App Password
# 1. Enable 2FA on your Google account
# 2. Go to myaccount.google.com → Security → App Passwords → create one
# 3. Paste the 16-char app password below (no spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=MarkGigs <your-gmail@gmail.com>

SITE_URL=http://localhost/markgig
